# Server
PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string
# Atlas -> Cluster -> Connect -> Drivers -> Node.js
# Replace <db_password> with your database user's password.
# Keep /expense_tracker before the "?" so the app uses the right database.
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@cluster0.xxxxx.mongodb.net/expense_tracker?retryWrites=true&w=majority

# Allowed frontend origin for CORS
CLIENT_ORIGIN=http://localhost:5173
